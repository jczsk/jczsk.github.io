---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

// 获取博客文章（用于媒体板块）
const media = (await getCollection("media"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3); // 首页只展示最新3篇

// 获取项目（用于副业推广板块）
const work = (await getCollection("work"))
  .filter(work => !work.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3); // 首页只展示最新3个
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- 1. 首屏核心区：黄金三秒定生死 -->
    <section class="animate space-y-4 mb-16">
      <h1 class="text-4xl font-bold text-black dark:text-white">
        {SITE.NAME} <span class="text-xl"></span>
      </h1>
      <p class="text-xl opacity-80">
        一人企业实战派 | 专注自动化开发与副业资源对接
      </p>
      <p class="opacity-70">
        提供正规网推项目对接、极客提效工具分享与全网自媒体干货。用代码与自动化，解决实际问题。
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="/work" class="px-4 py-2 bg-black text-white dark:bg-white dark:text-black rounded hover:opacity-80 transition">
          🔥 找项目赚钱
        </a>
        <a href="/tools" class="px-4 py-2 border border-black dark:border-white text-black dark:text-white rounded hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition">
          🛠️ 领提效工具
        </a>
      </div>
    </section>

    <div class="space-y-16">
      <!-- 2. 项目板块：副业推广拉新 -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            💰 推广兼职项目
          </h5>
          <Link href="/work">
            查看全部项目
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {work.map(work => (
            <li>
              <ArrowCard entry={work} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 3. 媒体板块：自媒体矩阵与干货 -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            📡 自媒体干货
          </h5>
          <Link href="/media">
            查看全部文章
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {media.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 4. 底部信任与转化区：全网收口 -->
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          与我联系 / 获取资源
        </h5>
        <article>
          <p>
            扫码添加主理人微信，备注“合作”获取最新项目对接权限，或免费领取提效工具包。
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
